{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "PLAYWRIGHT_MCP_BROWSER": "chromium"
  },
  "permissions": {
    "allow": [
      "Bash(xcrun simctl shutdown:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Search(*)",
      "Skill(*)",
      "ToolSearch(*)",
      "NotebookEdit(*)",
      "WebSearch",
      "WebFetch",
      "SendMessage(*)",
      "TaskCreate(*)",
      "TaskUpdate(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "EnterPlanMode(*)",
      "ExitPlanMode(*)",
      "ListMcpResourcesTool(*)",
      "ReadMcpResourceTool(*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -D issue-*)",
      "Bash(git push origin --delete issue-*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(git stash push *)",
      "Bash(git stash pop*)",
      "Bash(git pull --ff-only *)"
    ],
    "deny": [
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Docs",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/credentials.json)",
      "Read(//**/service-account*.json)",
      "Bash(*rm -rf*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(>/dev/*)",
      "Bash(curl*|*sh)",
      "Bash(wget*|*sh)",
      "Bash(*>~/.ssh/*)",
      "Bash(*>~/.zshrc)",
      "Bash(*>~/.bashrc)",
      "Bash(*>~/.profile)",
      "Bash(*>~/.zprofile)",
      "Bash(git push --force*main)",
      "Bash(git push -f*main)",
      "Bash(git push --force*master)",
      "Bash(git push -f*master)",
      "Bash(git push origin +main)",
      "Bash(git push origin +master)",
      "Bash(git reset --hard*)",
      "Bash(git reset --soft*)",
      "Bash(git reset --mixed*)",
      "Bash(git reset HEAD~*)",
      "Bash(git reset HEAD^*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(npm publish)",
      "Bash(pnpm publish)",
      "Bash(yarn publish)",
      "Bash(docker system prune)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(eval *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(osascript*)",
      "Bash(crontab*)",
      "Bash(launchctl*)",
      "Bash(node -e *)",
      "Bash(perl -e *)",
      "Bash(open http*)",
      "Bash(source /dev/*)",
      "Bash(*printenv*)",
      "Bash(*export -p*)",
      "Bash(*/etc/passwd*)",
      "Bash(*/etc/shadow*)",
      "Bash(*/etc/sudoers*)",
      "Bash(*kill -9*)",
      "Bash(*kill -KILL*)",
      "Bash(*killall *)",
      "Bash(*pkill *)",
      "Bash(shutdown:*)",
      "Bash(*reboot*)",
      "Bash(*chown *)",
      "Bash(mount:*)",
      "Bash(umount:*)",
      "Bash(*dscl *)",
      "mcp__claude_ai_Google_Sheets__update_values",
      "mcp__claude_ai_Google_Sheets__update_formulas",
      "mcp__claude_ai_Google_Sheets__update_spreadsheet",
      "mcp__claude_ai_Google_Sheets__insert_dimension",
      "Workflow",
      "SendFeedback"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:setup-writing-style": "off",
    "anthropic-skills:xlsx": "off",
    "dataviz": "off",
    "loop": "off",
    "run": "off",
    "plugin-authoring": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "claude-in-chrome": "off",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "init": "user-invocable-only",
    "schedule": "user-invocable-only",
    "workflow-authoring": "user-invocable-only"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Slack"
    },
    {
      "serverName": "claude.ai Adjust MCP"
    },
    {
      "serverName": "claude.ai Adobe for creativity"
    },
    {
      "serverName": "claude.ai Anthropic Economic Index"
    },
    {
      "serverName": "claude.ai AppsFlyer"
    },
    {
      "serverName": "claude.ai Canva"
    },
    {
      "serverName": "claude.ai ElevenLabs"
    },
    {
      "serverName": "claude.ai Figma"
    },
    {
      "serverName": "claude.ai Google Cloud BigQuery"
    },
    {
      "serverName": "claude.ai Higgsfield"
    },
    {
      "serverName": "claude.ai Miro"
    },
    {
      "serverName": "claude.ai Sensor Tower"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-ship-guard.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/remote-command-guard.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-force-push.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/kubectl-secret-read-guard.sh",
            "if": "Bash(*kubectl*)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-pr-generated-footer.sh",
            "if": "Bash(*gh *)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/orchestrator-exit-guard.py",
            "if": "Bash(*send-keys*)",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worker-bash-log.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worker-bash-log.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/output-secret-filter.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-orchestrator.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/work-session-title.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/idle-compact.py",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/orchestrator-close-check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skill-doctor@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 200000,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoMode": {
    "allow": [
      "$defaults",
      "세션 묶음 orchestrator 가 자기 tmux pane 에 tmux send-keys 로 '/rename <name>' 과 Enter 만 보내는 것은 허용한다. 다른 텍스트나 키는 허용하지 않는다"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(./scripts/deploy.sh:*) when run outside ~/personal/wid-blog — confirm working directory matches blog-publish skill's stated precondition before deploying"
    ],
    "environment": [
      "### Personal (public dotfiles — work org context is added from the --settings private file ~/.config/claude-private/settings.json)",
      "**Primary use of Claude Code**: software development on work repos (described in the local settings environment), maintaining this dotfiles repo, and occasional personal blog writing (Hugo)",
      "**Personal trusted repos**: ~/.dotfiles (github.com/byunghak/.dotfiles — PUBLIC, never commit company info) and the personal blog wid-blog/wid-blog with its GitHub Pages deploy target wid-blog/wid-blog.github.io",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; blog posts under content/posts/career/* need NDA/trade-secret review before publication",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries prod or production as a whole word or name segment"
    ]
  },
  "model": "opus"
}
