{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Search(*)",
      "Skill(*)",
      "ToolSearch(*)",
      "NotebookEdit(*)",
      "WebSearch",
      "WebSearch(*)",
      "WebFetch",
      "WebFetch(*)",
      "SendMessage(*)",
      "TaskCreate(*)",
      "TaskUpdate(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "EnterPlanMode(*)",
      "ExitPlanMode(*)",
      "ListMcpResourcesTool(*)",
      "ReadMcpResourceTool(*)",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_context7_context7__*"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/credentials.json)",
      "Read(//**/service-account*.json)",
      "Bash(*rm -rf*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(>/dev/*)",
      "Bash(curl*|*sh)",
      "Bash(wget*|*sh)",
      "Bash(*>~/.ssh/*)",
      "Bash(*>~/.zshrc)",
      "Bash(*>~/.bashrc)",
      "Bash(*>~/.profile)",
      "Bash(*>~/.zprofile)",
      "Bash(git push --force*main)",
      "Bash(git push -f*main)",
      "Bash(git push --force*master)",
      "Bash(git push -f*master)",
      "Bash(git push origin +main)",
      "Bash(git push origin +master)",
      "Bash(git reset --hard*)",
      "Bash(git reset --soft*)",
      "Bash(git reset --mixed*)",
      "Bash(git reset HEAD~*)",
      "Bash(git reset HEAD^*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(npm publish)",
      "Bash(pnpm publish)",
      "Bash(yarn publish)",
      "Bash(docker system prune)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(eval *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(osascript*)",
      "Bash(crontab*)",
      "Bash(launchctl*)",
      "Bash(python3 -c *import os*)",
      "Bash(node -e *)",
      "Bash(perl -e *)",
      "Bash(xargs *)",
      "Bash(open http*)",
      "Bash(source /dev/*)",
      "Bash(*printenv*)",
      "Bash(*export -p*)",
      "Bash(*/etc/passwd*)",
      "Bash(*/etc/shadow*)",
      "Bash(*/etc/sudoers*)",
      "Bash(*kill -9*)",
      "Bash(*kill -KILL*)",
      "Bash(*killall *)",
      "Bash(*pkill *)",
      "Bash(*shutdown*)",
      "Bash(*reboot*)",
      "Bash(*chown *)",
      "Bash(*mount *)",
      "Bash(*umount *)",
      "Bash(*dscl *)",
      "mcp__claude_ai_Google_Sheets__update_values",
      "mcp__claude_ai_Google_Sheets__update_formulas",
      "mcp__claude_ai_Google_Sheets__update_spreadsheet",
      "mcp__claude_ai_Google_Sheets__insert_dimension"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/remote-command-guard.sh",
            "timeout": 5000,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-force-push.sh",
            "timeout": 5000,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/kubectl-iac-guard.sh",
            "if": "Bash(*kubectl*)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-pr-generated-footer.sh",
            "if": "Bash(*gh *)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/output-secret-filter.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-file.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/security-auto-trigger.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/work-session-title.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-pane-claude.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'node_bin=$(volta which node 2>/dev/null || which node) && \"$node_bin\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)dist/index.js\"'"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "serena@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
